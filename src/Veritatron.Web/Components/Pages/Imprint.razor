@attribute [Route(SitePaths.Imprint)]
@inject IStringLocalizer<Imprint> Localizer
@inject IOptions<LegalOptions> LegalOptions

<PageTitle>@Localizer["Title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@Localizer["MetaDescription"]" />
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="vt-container vt-section">
    <Prose>
        <p class="vt-overline">@Localizer["Overline"]</p>
        <h1>@Localizer["Heading"]</h1>

        <h2>@Localizer["ProviderHeading"]</h2>
        <p>@LegalOptions.Value.Name<br />@LegalOptions.Value.Street<br />@LegalOptions.Value.City</p>

        <h2>@Localizer["ContactHeading"]</h2>
        <p>@Localizer["ContactEmailLabel"] @LegalOptions.Value.Email</p>

        <h2>@Localizer["ResponsibleHeading"]</h2>
        <p>@LegalOptions.Value.Name, @Localizer["ResponsibleAddress"]</p>
    </Prose>
</div>
