@inject IStringLocalizer<SiteFooter> Localizer
@inject TimeProvider TimeProvider

<footer class="site-footer">
    <div class="vt-container site-footer__inner">
        <div class="site-footer__brand">
            <a href="@SitePaths.Home" class="site-footer__logo" aria-label="@Localizer["HomeLink"]"><Logo /></a>
            <p class="site-footer__claim">@Localizer["Claim"]</p>
        </div>
        <nav aria-label="@Localizer["LegalNavigationLabel"]">
            <ul class="site-footer__links">
                <li><a href="@SitePaths.Imprint" class="site-footer__link">@Localizer["Imprint"]</a></li>
                <li><a href="@SitePaths.Privacy" class="site-footer__link">@Localizer["Privacy"]</a></li>
            </ul>
        </nav>
        <p class="site-footer__copyright">@Localizer["Copyright", _year]</p>
    </div>
</footer>

@code {
    private int _year;

    protected override void OnInitialized() => _year = TimeProvider.GetLocalNow().Year;
}
