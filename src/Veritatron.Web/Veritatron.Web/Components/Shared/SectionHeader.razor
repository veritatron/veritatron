<header class="section-header">
    <p class="vt-overline">@Overline</p>
    <h2 id="@TitleId" class="section-header__title">@Title</h2>
    @if (!string.IsNullOrEmpty(Intro))
    {
        <p class="section-header__intro">@Intro</p>
    }
</header>

@code {
    /// <summary>
    /// Element id of the heading, referenced by the section's <c>aria-labelledby</c>.
    /// </summary>
    [Parameter, EditorRequired]
    public string TitleId { get; set; } = string.Empty;

    /// <summary>
    /// Short label above the heading.
    /// </summary>
    [Parameter, EditorRequired]
    public string Overline { get; set; } = string.Empty;

    /// <summary>
    /// The section heading.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Optional introduction below the heading.
    /// </summary>
    [Parameter]
    public string? Intro { get; set; }
}
