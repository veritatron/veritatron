@inject IStringLocalizer<FocusAreas> Localizer

<section id="@SitePaths.FocusSectionId" class="vt-section focus" aria-labelledby="@TitleId">
    <div class="vt-container">
        <SectionHeader TitleId="@TitleId"
                       Overline="@Localizer["Overline"]"
                       Title="@Localizer["Title"]" />
        <ul class="focus__list">
            @foreach (var (key, icon) in Areas)
            {
                <li class="focus__item">
                    <MudIcon Icon="@icon" Color="Color.Primary" />
                    <h3 class="focus__title">@Localizer[$"{key}Title"]</h3>
                    <p class="focus__text">@Localizer[$"{key}Text"]</p>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private const string TitleId = "focus-title";

    private static readonly (string Key, string Icon)[] Areas =
    [
        ("Backend", Icons.Material.Rounded.Dns),
        ("Cloud", Icons.Material.Rounded.Cloud),
        ("Ai", Icons.Material.Rounded.Psychology),
    ];
}
