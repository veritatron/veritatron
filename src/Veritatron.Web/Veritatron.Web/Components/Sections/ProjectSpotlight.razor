@inject IStringLocalizer<ProjectSpotlight> Localizer

<article class="spotlight" aria-labelledby="@TitleId">
    <span class="spotlight__accent" aria-hidden="true"></span>
    <div class="spotlight__content">
        <span class="spotlight__badge">@(Subsite.IsLive ? Localizer["Live"] : Localizer["ComingSoon"])</span>
        <h3 id="@TitleId" class="spotlight__name">@Subsite.Name</h3>
        <p class="spotlight__description">@Subsite.Description</p>
        @if (Subsite.IsLive)
        {
            <div class="spotlight__action">
                <MudButton Href="@Subsite.Href"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           DropShadow="false"
                           EndIcon="@Icons.Material.Rounded.ArrowForward">
                    @Localizer["Open", Subsite.Name]
                </MudButton>
            </div>
        }
        else
        {
            <p class="spotlight__status">
                <span class="spotlight__pulse" aria-hidden="true"></span>
                @Localizer["InProgress"]
            </p>
        }
    </div>
    <div class="spotlight__visual" aria-hidden="true">
        <span class="spotlight__initial">@Initial</span>
    </div>
</article>

@code {
    private const string TitleId = "spotlight-title";

    /// <summary>
    /// The subsite to feature.
    /// </summary>
    [Parameter, EditorRequired]
    public Subsite Subsite { get; set; } = default!;

    private string Initial => string.IsNullOrEmpty(Subsite.Name) ? string.Empty : Subsite.Name[..1];
}
