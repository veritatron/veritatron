@inject IStringLocalizer<ProjectCard> Localizer

@if (Subsite.IsLive)
{
    <a class="card card--live" href="@Subsite.Url">
        <span class="card__accent" aria-hidden="true"></span>
        <h3 class="card__name">@Subsite.Name</h3>
        <p class="card__description">@Subsite.Description</p>
        <span class="card__footer">
            <span class="card__host">@Subsite.Url?.Host</span>
            <span class="card__arrow" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" />
            </span>
        </span>
    </a>
}
else
{
    <div class="card card--soon">
        <span class="card__accent" aria-hidden="true"></span>
        <span class="card__badge">@Localizer["ComingSoon"]</span>
        <h3 class="card__name">@Subsite.Name</h3>
        <p class="card__description">@Subsite.Description</p>
        <span class="card__footer">
            <span class="card__host">@Localizer["InProgress"]</span>
        </span>
    </div>
}

@code {
    /// <summary>
    /// The subsite the card shows.
    /// </summary>
    [Parameter, EditorRequired]
    public Subsite Subsite { get; set; } = default!;
}
