@inject IStringLocalizer<WorkshopTeaser> Localizer

<section class="vt-section workshop" aria-labelledby="@TitleId">
    <div class="vt-container">
        <div class="workshop__panel">
            <div class="workshop__content">
                <p class="vt-overline">@Localizer["Overline"]</p>
                <h2 id="@TitleId" class="workshop__title">@Localizer["Title"]</h2>
                <p class="workshop__text">@Localizer["Text"]</p>
            </div>
            <span class="workshop__badge">@Localizer["Badge"]</span>
        </div>
    </div>
</section>

@code {
    private const string TitleId = "workshop-title";
}
