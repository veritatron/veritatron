@inject IStringLocalizer<ProjectGrid> Localizer

<section id="@SitePaths.ProjectsSectionId" class="projects" aria-label="@Localizer["Label"]">
    <div class="vt-container">
        <ProductShowcase />
        @if (FurtherProjects.Count > 0)
        {
            <ul class="projects__list">
                @foreach (var subsite in FurtherProjects)
                {
                    <li><ProjectRow Subsite="subsite" /></li>
                }
            </ul>
        }
    </div>
</section>

@code {
    /// <summary>
    /// The subsites to show, in display order.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Subsite> Subsites { get; set; } = [];

    private List<Subsite> FurtherProjects =>
        Subsites.Where(subsite => subsite.Path != SitePaths.Words2Widget).ToList();
}
